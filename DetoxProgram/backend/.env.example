# =========================================================================
# 백엔드 환경 변수 설정 템플릿 (.env.example)
# 이 파일을 복사하여 `.env` 파일을 만들고 실제 값을 채우십시오.
# =========================================================================

# 데이터베이스 연결 URL (비워두면 로컬 SQLite인 sqlite:///./test.db 로 자동 연동됩니다)
DATABASE_URL=sqlite:///./test.db

# Google Cloud 서비스 계정 자격증명 파일 경로 (GCP 자연어 NLP API 호출용)
# others 폴더에 있는 JSON 키 파일 이름을 넣거나 백엔드 폴더 내부로 복사한 파일명을 적어주세요.
GOOGLE_APPLICATION_CREDENTIALS=gcp_creds.json

# Google AI Studio Gemini API Key (디톡스 처방 리포트 생성용)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key (유튜브 영상 태그/카테고리 정보 메타 파싱용)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase 연동 정보 (설정 및 사용자 데이터 보관용)
SUPABASE_URL=https://your_supabase_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# CORS 허용 주소 목록 (배포/터널 도메인이 생길 경우 쉼표로 연결해서 등록 가능)
# 예: http://localhost:3000,https://my-frontend.trycloudflare.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
