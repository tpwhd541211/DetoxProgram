# =========================================================================
# 프론트엔드 환경 변수 설정 템플릿 (.env.local.example)
# 이 파일을 복사하여 `.env.local` 파일을 만들고 실제 값을 채우십시오.
# =========================================================================

# Supabase 연동 정보
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 백엔드 API 주소 (로컬에서 Nginx 프록시로 실행할 경우 포트 8080을 그대로 타면 됩니다)
# 터널링/도메인을 공유할 경우 단일 터널인 경우 상대경로로도 작동하지만, 명시할 경우 이 값을 수정합니다.
NEXT_PUBLIC_API_URL=http://localhost:8080
